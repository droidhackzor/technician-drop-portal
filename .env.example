DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cable_drop_portal?schema=public"
JWT_SECRET="change-this-to-a-long-random-string"
UPLOAD_DIR=public/uploads
# For Railway with a mounted persistent volume at /uploads, use:
# UPLOAD_DIR=/uploads
SEED_ON_STARTUP=true

# Optional Microsoft OAuth login
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8080/api/auth/microsoft/callback
NEXT_PUBLIC_MICROSOFT_LOGIN_ENABLED=false
